# Required for persistence. Without it the app runs in demo mode.
DATABASE_URL=postgres://user:password@host:5432/ai_revenue_inbox

# LLM. If no key is set, the app uses the deterministic heuristic analyzer.
LLM_PROVIDER=openai # openai | anthropic | heuristic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Telegram intake + notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Google service account sync (optional). Share the Sheet/Calendar with GOOGLE_CLIENT_EMAIL.
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=
GOOGLE_CALENDAR_ID=

# Protect cron/webhook routes in production
CRON_SECRET=
APP_BASE_URL=http://localhost:3000
